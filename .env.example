# Public production URL used for canonical links, Open Graph metadata and sitemaps.
NEXT_PUBLIC_SITE_URL=https://www.allfireservices.com.au

# Required by the /api/chat route at runtime. Configure this in Vercel.
GEMINI_API_KEY=

# Required by the /api/contact route at runtime to send enquiry emails.
# Get a key from https://resend.com/api-keys
RESEND_API_KEY=

# Where contact form submissions are delivered.
# Defaults to admin@allfireservices.com.au if unset.
CONTACT_TO_EMAIL=

# The "from" address used on outgoing contact emails.
# For local dev / first deploy, use Resend's shared sandbox sender:
#   onboarding@resend.dev
# For production, verify a domain in Resend and use something like:
#   "All Fire Services Website <noreply@yourdomain.com>"
CONTACT_FROM_EMAIL=onboarding@resend.dev
