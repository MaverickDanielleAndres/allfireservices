  <script type="rocketlazyloadscript">
    (function(){
      const root = document.getElementById('apex-header');
      const menu = document.getElementById('apxMenu');

      window.toggleApxMenu = function(){
        const open = menu.classList.toggle('active');
        menu.setAttribute('aria-hidden', String(!open));
      };

      window.toggleApxDropdown = function(key){
        const box = document.getElementById('apx-dd-' + key);
        if (box) box.classList.toggle('active');
      };

      // Close on outside click
      document.addEventListener('click', function(e){
        if (!root.contains(e.target) && menu.classList.contains('active')) {
          menu.classList.remove('active');
          menu.setAttribute('aria-hidden','true');
        }
      });

      // Close on any menu link click
      root.querySelectorAll('.apx-link, .apx-dd a').forEach(a=>{
        a.addEventListener('click', ()=>{
          menu.classList.remove('active');
          menu.setAttribute('aria-hidden','true');
        });
      });
    })();
  </script>
