    <link rel="preload" as="image" href="https://www.apexpumps.com.au/wp-content/uploads/hero.webp" fetchpriority="high">
    <style>
    /* Critical CSS for above-the-fold content */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Roboto', sans-serif; line-height: 1.6; color: #333; }
    .hero { background: linear-gradient(135deg, rgba(36, 204, 255, 0.95) 0%, rgba(0, 0, 0, 0.9) 30%, rgba(49, 123, 144, 0.85) 70%, rgba(36, 204, 255, 0.95) 100%), var(--wpr-bg-320cc636-3d85-4e1e-aeb5-692512f9d725); background-size: cover; background-position: center; color: white; padding: 100px 0; text-align: center; }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
    
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* Sharp corners for all elements */
        * {
            border-radius: 0 !important;
        }

        body {
            font-family: 'Source Sans Pro', sans-serif; font-display: swap;
            line-height: 1.6;
            color: #1a1a1a;
            background-color: #f8f9fa;
            overflow-x: hidden;
        }

        /* Prevent text overflow */
        * {
            word-wrap: break-word;
            overflow-wrap: break-word;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Hero Section */
        .hero {
            background: 
                linear-gradient(135deg, rgba(36, 204, 255, 0.95) 0%, rgba(0, 0, 0, 0.9) 30%, rgba(49, 123, 144, 0.85) 70%, rgba(36, 204, 255, 0.95) 100%),
                radial-gradient(circle at 20% 80%, rgba(36, 204, 255, 0.4) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(49, 123, 144, 0.4) 0%, transparent 50%),
                var(--wpr-bg-7f4e4165-4cf1-4aa6-8e48-2ecf00c5f86a);
            background-size: cover, cover, cover, cover;
            background-position: center, center, center, center;
            color: white;
            padding: 120px 0 80px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
    /* Override Elementor's !important rules with more specific selectors */
        .hero.elementor-1590,
        [class*="theme-"] .hero,
        [id*="theme-"] .hero {
            background: linear-gradient(135deg, rgba(36, 204, 255, 0.8) 0%, rgba(0, 0, 0, 0.6) 100%), 
                        var(--wpr-bg-c1139ea1-1e77-4179-8a37-0bd6f7cfa8d9) !important;
            background-size: cover !important;
            background-position: center !important;
        }
        .hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: 
                linear-gradient(45deg, transparent 30%, rgba(255,255,255,0.1) 50%, transparent 70%),
                linear-gradient(90deg, transparent 0%, rgba(36, 204, 255, 0.1) 25%, transparent 50%, rgba(49, 123, 144, 0.1) 75%, transparent 100%);
            animation: shimmer 4s ease-in-out infinite;
        }

        .hero::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: 
                radial-gradient(ellipse at center, transparent 0%, rgba(0,0,0,0.1) 70%, rgba(0,0,0,0.2) 100%);
            pointer-events: none;
        }

        @keyframes shimmer {
            0% { 
                transform: translateX(-100%) translateY(0);
                opacity: 0.3;
            }
            50% { 
                transform: translateX(0%) translateY(-10px);
                opacity: 0.7;
            }
            100% { 
                transform: translateX(100%) translateY(0);
                opacity: 0.3;
            }
        }

        .hero h1 {
            font-family: 'Roboto', sans-serif; font-display: swap;
            font-weight: 700;
            font-size: 3.5rem;
            letter-spacing: -0.02em;
            margin-bottom: 1.5rem;
            line-height: 1.2;
            animation: fadeInUp 1s ease-out;
        }

        .hero p {
            font-size: 1.25rem;
            margin-bottom: 2.5rem;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
            opacity: 0.9;
            animation: fadeInUp 1s ease-out 0.3s both;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .cta-button {
            display: inline-block;
            background: linear-gradient(135deg, #24ccff 0%, #317b90 100%);
            color: white !important;
            padding: 15px 30px;
            text-decoration: none;
            font-family: 'Roboto', sans-serif; font-display: swap;
            font-weight: 500;
            font-size: 1.1rem;
            border-radius: 0;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
            position: relative;
            overflow: hidden;
            animation: fadeInUp 1s ease-out 0.6s both;
        }

        .cta-button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.5s ease;
        }

        .cta-button:hover {
            background: linear-gradient(135deg, #317b90 0%, #24ccff 100%);
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(36, 204, 255, 0.3);
        }

        .cta-button:hover::before {
            left: 100%;
        }

        /* Experience Section */
        .experience {
            padding: 80px 0;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 50%, #f8f9fa 100%);
            position: relative;
            overflow: hidden;
        }

        .experience::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(45deg, transparent 40%, rgba(36, 204, 255, 0.05) 50%, transparent 60%);
            animation: float 6s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }

        .experience-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            align-items: stretch;
        }

        .experience-item {
            display: flex;
            align-items: center;
            gap: 0;
            padding: 0;
            background: white;
            border: 1px solid #E5E5E5;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            height: 220px;
        }

        .experience-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(180deg, #24ccff, #317b90);
            transform: scaleY(0);
            transition: transform 0.3s ease;
        }

        .experience-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        }

        .experience-item:hover::before {
            transform: scaleY(1);
        }

        .experience-icon {
            width: 220px;
            height: 220px;
            background: transparent;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
            border-radius: 0;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            margin: 0;
        }

        .experience-icon::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(45deg, transparent 30%, rgba(255,255,255,0.2) 50%, transparent 70%);
            transform: translateX(-100%);
            transition: transform 0.6s ease;
        }

        .experience-icon::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(45deg, transparent, rgba(255,255,255,0.1), transparent);
            transform: rotate(45deg) translateX(-100%);
            transition: transform 0.8s ease;
        }

        .experience-icon:hover {
            transform: scale(1.02);
            box-shadow: 0 20px 40px rgba(36, 204, 255, 0.4);
        }

        .experience-icon:hover::before {
            transform: translateX(100%);
        }

        .experience-icon:hover::after {
            transform: rotate(45deg) translateX(100%);
        }

        .experience-icon .image-placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            color: white;
            font-size: 0.9rem;
            text-align: center;
            padding: 0;
            background-size: cover;
            background-position: center;
        }

        .experience-content {
            flex: 1;
            padding: 30px 30px 30px 20px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-width: 0;
            overflow-wrap: break-word;
        }

        .experience-content h3 {
            font-family: 'Roboto', sans-serif; font-display: swap;
            font-weight: 500;
            font-size: 1.5rem;
            letter-spacing: -0.02em;
            margin-bottom: 1rem;
            color: #1a1a1a;
            position: relative;
            word-wrap: break-word;
            hyphens: auto;
        }

        .experience-content h3::after {
            content: '';
            position: absolute;
            bottom: -8px;
            left: 0;
            width: 60px;
            height: 3px;
            background: linear-gradient(90deg, #24ccff, #317b90);
            transition: width 0.3s ease;
        }

        .experience-item:hover .experience-content h3::after {
            width: 100px;
        }

        .experience-content p {
            color: #666;
            font-size: 0.9rem;
            line-height: 1.5;
            margin-top: 0.5rem;
            word-wrap: break-word;
            hyphens: auto;
        }

        /* About Section */
        .about {
            padding: 80px 0;
            background: linear-gradient(135deg, white 0%, #f8f9fa 50%, white 100%);
            position: relative;
        }

        .about::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, #24ccff, transparent);
        }

        .about-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
        }

        .about-text h4 {
            font-family: 'Roboto', sans-serif; font-display: swap;
            font-weight: 700;
            font-size: 2rem;
            letter-spacing: -0.02em;
            margin-bottom: 1.5rem;
            color: #1a1a1a;
            word-wrap: break-word;
            hyphens: auto;
        }

        .about-text p {
            margin-bottom: 1.5rem;
            color: #666;
            word-wrap: break-word;
            hyphens: auto;
        }

        .feature-list {
            list-style: none;
            margin: 2rem 0;
        }

        .feature-list li {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 1rem;
            color: #666;
        }

        .feature-list li::before {
            content: '→';
            color: #317b90;
            font-weight: bold;
            font-size: 1.2rem;
        }

        .contact-info {
            margin-top: 2rem;
        }

        .contact-info h5 {
            font-family: 'Roboto', sans-serif; font-display: swap;
            font-weight: 500;
            font-size: 1.2rem;
            margin-bottom: 0.5rem;
            color: #1a1a1a;
        }

        .phone-number {
            font-family: 'Roboto', sans-serif; font-display: swap;
            font-weight: 500;
            font-size: 2rem;
            color: #317b90;
            letter-spacing: -0.02em;
        }

        .call-cta-button {
            display: flex;
            align-items: center;
            gap: 20px;
            text-decoration: none;
            padding: 15px 25px;
            background: #000000;
            color: white;
            border-radius: 8px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .call-cta-button:hover {
            background: #333333;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.2);
        }

        .call-cta-button .call-text {
            font-family: 'Roboto', sans-serif; font-display: swap;
            font-weight: 700;
            font-size: 1.2rem;
            color: #ffffff;
        }

        .call-cta-button .phone-number {
            font-family: 'Roboto', sans-serif; font-display: swap;
            font-weight: 700;
            font-size: 1.8rem;
            color: #24ccff;
            margin: 0;
        }

        .about-image {
            background: transparent;
            height: 400px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .about-image::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(45deg, transparent 30%, rgba(255,255,255,0.1) 50%, transparent 70%);
            animation: shimmer 4s ease-in-out infinite;
        }

        .about-image:hover {
            transform: scale(1.02);
            box-shadow: 0 20px 40px rgba(36, 204, 255, 0.3);
        }

        .about-image .image-placeholder {
            background-size: cover !important;
            background-position: center !important;
            background-repeat: no-repeat !important;
        }

        /* Services Section */
        .services {
            padding: 80px 0;
            background: linear-gradient(135deg, #24ccff 0%, #317b90 50%, #24ccff 100%);
            color: white;
            position: relative;
            overflow: hidden;
        }

        .services::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(45deg, transparent 20%, rgba(255,255,255,0.05) 50%, transparent 80%);
            animation: wave 8s ease-in-out infinite;
        }

        @keyframes wave {
            0%, 100% { transform: translateX(-100%); }
            50% { transform: translateX(100%); }
        }

        .section-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .section-header h3 {
            font-family: 'Roboto', sans-serif; font-display: swap;
            font-weight: 700;
            font-size: 2.5rem;
            letter-spacing: -0.02em;
            color: white;
            margin-bottom: 1rem;
        }

        .section-header p {
            font-size: 1.1rem;
            color: rgba(255,255,255,0.9);
            max-width: 600px;
            margin: 0 auto;
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 30px;
            margin-top: 60px;
        }

        .service-card {
            background: linear-gradient(135deg, #F5F5F5 0%, #FFFFFF 100%);
            border: none;
            padding: 50px 40px;
            text-align: left;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            min-height: 250px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .service-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #24ccff, #317b90, #24ccff);
            transform: scaleX(0);
            transition: transform 0.4s ease;
        }

        .service-card::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, #24ccff 0%, #317b90 100%);
            transform: translateX(100%);
            transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 1;
        }

        .service-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
        }

        .service-card:hover::before {
            transform: scaleX(1);
        }

        .service-card:hover::after {
            transform: translateX(0);
        }

        .service-header {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 20px;
            position: relative;
            z-index: 2;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .service-number {
            font-family: 'Roboto', sans-serif; font-display: swap;
            font-weight: 700;
            font-size: 2.5rem;
            color: #24ccff;
            line-height: 1;
            opacity: 0.8;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .service-card:hover .service-number {
            transform: scale(1.2);
            opacity: 1;
            color: #317b90;
        }

        .service-image {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 3;
            transform: translateX(100%);
            transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .service-card:hover .service-image {
            transform: translateX(0);
        }

        .image-placeholder {
            background: transparent;
            color: white;
            padding: 0;
            text-align: center;
            font-size: 1.1rem;
            border: none;
            max-width: 100%;
            width: 100%;
            height: 100%;
        }

        .service-card h4 {
            font-family: 'Roboto', sans-serif; font-display: swap;
            font-weight: 500;
            font-size: 1.4rem;
            letter-spacing: -0.02em;
            margin: 0;
            color: #1a1a1a;
            position: relative;
            z-index: 2;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            flex: 1;
        }

        .service-card p {
            color: #666;
            margin: 0;
            position: relative;
            z-index: 2;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            line-height: 1.7;
        }

        .service-card:hover h4,
        .service-card:hover p {
            transform: translateX(-100%);
            opacity: 0;
        }

        .service-accent {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, #24ccff, #317b90, #24ccff);
            transform: scaleX(0);
            transition: transform 0.4s ease;
            z-index: 2;
        }

        .service-card:hover .service-accent {
            transform: scaleX(1);
        }

        .service-card:hover .service-header {
            transform: translateX(-100%);
            opacity: 0;
        }

        .read-more-button {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(255, 255, 255, 0.95);
            color: #317b90 !important;
            padding: 12px 24px;
            border: 2px solid #317b90;
            border-radius: 0;
            text-decoration: none;
            font-family: 'Roboto', sans-serif; font-display: swap;
            font-weight: 600;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            z-index: 3;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .read-more-button:hover {
            background: #317b90;
            color: white !important;
            transform: translate(-50%, -50%) scale(1.05);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
        }

        .service-card:hover .read-more-button {
            opacity: 1;
            visibility: visible;
        }

        .service-cta {
            margin-top: 40px;
            text-align: center;
        }

        .service-cta-btn {
            background: #000000 !important;
            color: white !important;
        }

        .service-cta-btn:hover {
            background: #333333 !important;
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        }

        /* CTA Banner */
        .cta-banner {
            background: linear-gradient(135deg, #24ccff 0%, #317b90 50%, #24ccff 100%);
            color: white;
            padding: 60px 0;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .cta-banner::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(45deg, transparent 30%, rgba(255,255,255,0.1) 50%, transparent 70%);
            animation: shimmer 3s ease-in-out infinite;
        }

        .cta-banner h4 {
            font-family: 'Roboto', sans-serif; font-display: swap;
            font-weight: 500;
            font-size: 2.5rem;
            letter-spacing: -0.02em;
            margin-bottom: 1rem;
        }

        .cta-banner p {
            font-size: 1.1rem;
            margin-bottom: 2rem;
            opacity: 0.9;
        }

        .cta-button.secondary {
            background: linear-gradient(135deg, #317b90 0%, #1a4a5a 100%);
            color: white;
        }

        .cta-button.secondary:hover {
            background: linear-gradient(135deg, #1a4a5a 0%, #317b90 100%);
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(49, 123, 144, 0.3);
        }

      /* FPA Membership Section */
.fpa-membership {
    padding: 80px 0;
    background: linear-gradient(135deg, #f8f9fa 0%, #FFFFFF 50%, #f8f9fa 100%);
    position: relative;
    overflow: hidden;
}

.fpa-membership::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, #24ccff, transparent);
}

.fpa-membership .section-header h3 {
    color: #1a1a1a;
    font-family: 'Roboto', sans-serif;
    font-weight: 700;
    font-size: 2.5rem;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
    text-align: center;
}

.fpa-membership .section-header p {
    color: #666;
    font-size: 1.1rem;
    text-align: center;
    margin-bottom: 40px;
}

.membership-container {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 40px;
}

.membership-logo {
    background: white;
    border: 1px solid #E5E5E5;
    border-radius: 12px;
    padding: 30px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    transition: all 0.3s ease;
}

.membership-logo:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    border-color: #24ccff;
}

/* Mobile Responsive */
@media (max-width: 768px) {
    .fpa-membership .section-header h3 {
        font-size: 2rem;
    }
    
    .fpa-membership .section-header p {
        font-size: 1rem;
    }
    
    .membership-logo {
        padding: 20px;
    }
    
    .membership-logo img {
        height: 100px;
        max-width: 250px;
    }
}

@media (max-width: 480px) {
    .fpa-membership .section-header h3 {
        font-size: 1.5rem;
    }
    
    .membership-logo img {
        height: 80px;
        max-width: 200px;
    }
}
        /* Solutions Section */
        .solutions {
            padding: 80px 0;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 50%, #f8f9fa 100%);
            position: relative;
        }

        .solutions::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, #24ccff, transparent);
        }

        .solutions-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: stretch;
        }

        .solutions-list {
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        .solution-item {
            display: flex;
            align-items: flex-start;
            gap: 20px;
            padding: 20px;
            background: white;
            border: 1px solid #E5E5E5;
            transition: box-shadow 0.3s ease;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        }

        .solution-item:hover {
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }

        .solution-icon {
            width: 40px;
            height: 40px;
            background: #317b90;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1rem;
        }

        .solution-content h4 {
            font-family: 'Roboto', sans-serif; font-display: swap;
            font-weight: 500;
            font-size: 1.3rem;
            letter-spacing: -0.02em;
            margin-bottom: 0.5rem;
            color: #0D0E0F;
        }

        .solution-content p {
            color: #666;
            line-height: 1.6;
        }

        .solutions-image {
            background: linear-gradient(135deg, #425B5F 0%, #2C3E50 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
            text-align: center;
            padding: 40px;
        }

        /* Features Section */
        .features {
            padding: 80px 0;
            background: white;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .feature-card {
            background: white;
            border: 1px solid #E5E5E5;
            padding: 0;
            text-align: center;
            transition: box-shadow 0.3s ease;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .feature-card:hover {
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }

        .feature-image {
            height: 200px;
            background: linear-gradient(135deg, #24ccff 0%, #317b90 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1rem;
            text-align: center;
            padding: 20px;
        }

        .feature-content {
            padding: 30px;
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .feature-icon {
            display: none;
        }

        .feature-card h4 {
            font-family: 'Roboto', sans-serif; font-display: swap;
            font-weight: 500;
            font-size: 1.2rem;
            letter-spacing: -0.02em;
            margin-bottom: 1rem;
            color: #000000;
        }

        .features .section-header h3 {
            color: #000000;
        }

        .solutions .section-header h3 {
            color: #000000;
        }

        .feature-card p {
            color: #666;
            line-height: 1.6;
        }

        /* Mobile Responsive */
        @media (max-width: 768px) {
            .hero h2 {
                font-size: 2.5rem;
            }

            .experience-grid {
                grid-template-columns: 1fr;
                gap: 40px;
            }

            .experience-item {
                height: auto;
                flex-direction: column;
                min-height: auto;
            }

            .experience-icon {
                width: 100%;
                height: 200px;
                flex-shrink: 0;
            }

            .experience-content {
                padding: 20px;
                flex: 1;
                min-width: 0;
            }

            .about-content {
                grid-template-columns: 1fr;
                gap: 40px;
            }

            .services-grid {
                grid-template-columns: 1fr;
            }

            .solutions-content {
                grid-template-columns: 1fr;
            }

            .features-grid {
                grid-template-columns: 1fr;
            }

            .cta-button {
                width: 100%;
                max-width: 300px;
            }

            /* Mobile carousel adjustments */
            .carousel-track {
                animation-duration: 20s;
                width: calc(120px * 18);
            }

            .carousel-slide {
                flex: 0 0 120px;
                margin: 0 15px;
            }

            .client-logo {
                padding: 15px;
                min-height: 70px;
                width: 100px;
            }

            .client-logo svg {
                width: 100px;
                height: 60px;
            }
        }

        @media (max-width: 480px) {
            .container {
                padding: 0 8px;
            }
            
            .hero h2 {
                font-size: 2rem;
            }
            
            .experience-content h3 {
                font-size: 1.2rem;
                line-height: 1.3;
            }
            
            .experience-content p {
                font-size: 0.85rem;
                line-height: 1.4;
            }
            
            .about-text h4 {
                font-size: 1.5rem;
            }
            
            .about-text p {
                font-size: 0.9rem;
                line-height: 1.4;
            }
        }

        /* Extra small screens */
        @media (max-width: 360px) {
            .container {
                padding: 0 5px;
            }
            
            .hero h2 {
                font-size: 1.8rem;
                line-height: 1.2;
            }
            
            .hero p {
                font-size: 0.9rem;
            }
            
            .experience-content h3 {
                font-size: 1.1rem;
                line-height: 1.2;
            }
            
            .experience-content p {
                font-size: 0.8rem;
                line-height: 1.3;
            }
            
            .about-text h4 {
                font-size: 1.3rem;
                line-height: 1.2;
            }
            
            .about-text p {
                font-size: 0.9rem;
                line-height: 1.4;
            }
        }

    /* Spare Parts Banner Styles */
    .spare-parts-banner {
        width: 100%;
        background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 50%, #000000 100%);
        color: white;
        padding: 80px 20px;
        position: relative;
        overflow: hidden;
        margin: 0;
        border-top: 3px solid #24ccff;
        border-bottom: 3px solid #24ccff;
    }

    .spare-parts-banner::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: 
            radial-gradient(circle at 20% 50%, rgba(36, 204, 255, 0.08) 0%, transparent 50%),
            radial-gradient(circle at 80% 50%, rgba(49, 123, 144, 0.06) 0%, transparent 50%);
        pointer-events: none;
    }

    .spare-parts-banner::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(36, 204, 255, 0.3), transparent);
        transform: translateY(-50%);
    }

    .spare-parts-banner-content {
        max-width: 1200px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: center;
    }

    .spare-parts-banner-left {
        text-align: left;
    }

    .spare-parts-banner-right {
        text-align: right;
    }

    .spare-parts-banner .banner-badge {
        display: inline-block;
        background: #24ccff;
        color: #000000;
        padding: 8px 20px;
        font-family: 'Roboto', sans-serif;
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 20px;
    }

    .spare-parts-banner h3 {
        font-family: 'Roboto', sans-serif;
        font-weight: 700;
        font-size: 3rem;
        letter-spacing: -0.02em;
        margin-bottom: 20px;
        line-height: 1.2;
        color: #ffffff;
    }

    .spare-parts-banner h3 .highlight {
        color: #24ccff;
    }

    .spare-parts-banner p {
        font-family: 'Source Sans Pro', sans-serif;
        font-size: 1.2rem;
        margin-bottom: 30px;
        opacity: 0.9;
        line-height: 1.7;
        color: #e0e0e0;
    }

    .spare-parts-features-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 30px;
    }

    .spare-parts-feature-item {
        padding: 20px;
        background: rgba(255, 255, 255, 0.05);
        border-left: 3px solid #24ccff;
        transition: all 0.3s ease;
    }

    .spare-parts-feature-item:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateX(5px);
    }

    .spare-parts-feature-item strong {
        display: block;
        font-family: 'Roboto', sans-serif;
        font-weight: 600;
        font-size: 1rem;
        color: #24ccff;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .spare-parts-feature-item span {
        display: block;
        font-size: 0.9rem;
        color: #b0b0b0;
        line-height: 1.5;
    }

    .spare-parts-cta-button {
        display: inline-block;
        background: #24ccff;
        color: white!important;
        padding: 18px 50px;
        text-decoration: none;
        font-family: 'Roboto', sans-serif;
        font-weight: 700;
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .spare-parts-cta-button::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
        transition: left 0.5s ease;
        color: white;
    }

    .spare-parts-cta-button:hover {
        background: #317b90;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(36, 204, 255, 0.3);
    }

    .spare-parts-cta-button:hover::before {
        left: 100%;
    }

    .spare-parts-cta-button::after {
        content: '→';
        margin-left: 10px;
        transition: transform 0.3s ease;
        display: inline-block;
    }

    .spare-parts-cta-button:hover::after {
        transform: translateX(5px);
    }

    .spare-parts-stats {
        display: flex;
        flex-direction: column;
        gap: 25px;
    }

    .spare-parts-stat {
        text-align: right;
    }

    .spare-parts-stat-number {
        font-family: 'Roboto', sans-serif;
        font-weight: 700;
        font-size: 3.5rem;
        color: #24ccff;
        line-height: 1;
        margin-bottom: 5px;
    }

    .spare-parts-stat-label {
        font-family: 'Source Sans Pro', sans-serif;
        font-size: 1rem;
        color: #b0b0b0;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* Mobile Responsive for Spare Parts Banner */
    @media (max-width: 968px) {
        .spare-parts-banner-content {
            grid-template-columns: 1fr;
            gap: 40px;
            text-align: center;
        }

        .spare-parts-banner-left,
        .spare-parts-banner-right {
            text-align: center;
        }

        .spare-parts-features-grid {
            grid-template-columns: 1fr;
        }

        .spare-parts-feature-item {
            border-left: none;
            border-top: 3px solid #24ccff;
        }

        .spare-parts-feature-item:hover {
            transform: translateY(-3px);
        }

        .spare-parts-stats {
            flex-direction: row;
            justify-content: center;
            flex-wrap: wrap;
        }

        .spare-parts-stat {
            text-align: center;
            min-width: 150px;
        }
    }

    @media (max-width: 768px) {
        .spare-parts-banner {
            padding: 60px 15px;
        }

        .spare-parts-banner h3 {
            font-size: 2.2rem;
        }

        .spare-parts-banner p {
            font-size: 1.1rem;
        }

        .spare-parts-stat-number {
            font-size: 2.5rem;
        }
    }

    @media (max-width: 480px) {
        .spare-parts-banner h3 {
            font-size: 1.8rem;
        }

        .spare-parts-banner p {
            font-size: 1rem;
        }

        .spare-parts-cta-button {
            padding: 15px 35px;
            font-size: 0.9rem;
        }
    }
</style>
