  <style>
    /* Base */
    #apex-header * { box-sizing: border-box; border-radius: 0 !important; word-wrap: break-word; overflow-wrap: break-word; }
    #apex-header { font-family: 'Source Sans Pro', sans-serif; line-height:1.6; color:#fff; background:#000; }
    #apex-header .container { max-width:1200px; margin:0 auto; padding:0 16px; }

    .top-contact-bar { background:#24ccff; color:#000; padding:8px 0; font-size:15px; font-weight:700; }
    .contact-info { display:flex; justify-content:space-between; align-items:center; }
    .contact-left { display:flex; align-items:center; gap:15px; }
    .contact-item, .emergency-service, .separator { color:#000; font-weight:700; font-size:15px; text-decoration:none; }
/* Fix excess blue bar caused by .contact-info margin */
#apex-header .contact-info {
  margin-top: 0 !important;
}
    .header { background:#000; position:sticky; top:0; z-index:1000; }
    .nav { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:12px 0; }
    .logo-image { height:48px; width:auto; } /* mobile default */

    .nav-links { display:none; } /* mobile default */
    .nav-link { color:#fff; text-decoration:none; font:500 16px/1.2 Roboto,sans-serif; display:flex; gap:5px; transition:color .2s; }
    .nav-link:hover, .nav-link.active { color:#24ccff; }

    .nav-dropdown { position:relative; }
    .dropdown-menu { display:none; position:absolute; top:calc(100% - 2px); left:0; background:#317b90; min-width:200px; box-shadow:0 4px 12px rgba(0,0,0,.15); z-index:1001; }
    .nav-dropdown:hover .dropdown-menu { display:block; }
    .dropdown-menu a { color:#fff; text-decoration:none; padding:12px 20px; display:block; font:500 14px Roboto,sans-serif; border-bottom:1px solid rgba(255,255,255,.2); }
    .dropdown-menu a:hover { background:rgba(255,255,255,.1); }

    .apx-right { margin-left:auto; display:flex; align-items:center; gap:10px; }
    .call-now-btn {
      background:#24ccff; color:#000; padding:10px 16px; text-decoration:none;
      font:700 13px Roboto,sans-serif; text-transform:uppercase; letter-spacing:.5px;
      display:inline-flex; align-items:center; gap:8px; border:0; border-radius:4px;
      transition:transform .15s ease, box-shadow .15s ease; white-space:nowrap;
    }
    .call-now-btn:hover { transform:translateY(-1px); box-shadow:0 6px 14px rgba(36,204,255,.35); }

    /* Burger */
    #apxBurger {
      display:flex; width:44px; height:44px;
      background:rgba(255,255,255,0.08);
      border:1px solid rgba(255,255,255,0.35);
      color:#fff; border-radius:4px; cursor:pointer;
      font-size:24px; line-height:1; padding:0;
      align-items:center; justify-content:center;
    }

    /* Slideout menu */
    .apx-menu { display:none; position:absolute; top:100%; right:0; width:86vw; max-width:320px;
      background:#000; border:1px solid #333; box-shadow:0 8px 30px rgba(0,0,0,.4);
      z-index:1500; padding:16px 0; max-height:80vh; overflow-y:auto; }
    .apx-menu.active { display:block !important; }
    .apx-list { display:flex; flex-direction:column; }
    .apx-link { color:#fff !important; text-decoration:none; font:500 16px Roboto,sans-serif; padding:12px 20px; border-bottom:1px solid #333; display:block; }
    .apx-dropdown { border-bottom:1px solid #333; }
    .apx-dd-toggle { color:#fff !important; font:500 16px Roboto,sans-serif; padding:12px 20px; display:block; cursor:pointer; }
    .apx-dd { display:none; background:#111; }
    .apx-dd.active { display:block; }
    .apx-dd a { color:#ccc !important; text-decoration:none; font:400 14px Roboto,sans-serif; display:block; padding:10px 40px; border-bottom:1px solid #333; }

    /* Desktop overrides */
    @media (min-width: 1025px){
      .logo-image { height:56px; }
      .nav-links { display:flex; justify-content:center; align-items:center; gap:24px; flex:1; }
      #apxBurger { display:none; }
    }

    /* Hide contact bar on mobile */
    @media (max-width: 1024px){
      .top-contact-bar { display:none !important; }
      .header { border-top:30px solid #24ccff; overflow:visible; }
    }
    
/* --- Mobile hard overrides --- */
@media (max-width: 1024px){
  /* Force-hide desktop links on mobile no matter what the theme does */
  #apex-header .nav .nav-links {
    display: none !important;
  }

  /* Make sure the burger & call button align nicely */
  #apex-header .nav {
    align-items: center;
    justify-content: space-between;
  }

  /* Optional: smaller call button so it doesn't crowd the burger */
  #apex-header .call-now-btn {
    padding: 8px 12px;
    font-size: 12px;
  }
}

/* Keep desktop links on a single line when visible (prevents “About / Us” wrap) */
#apex-header .nav-link { white-space: nowrap; }


