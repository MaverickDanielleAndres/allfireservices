                        <h4>Our Services</h4>
                        <ul class="footer-services">
                            <li><span class="chevron">→</span> <a href="/fire-pump-installation-sydney">Installation</a></li>
                            <li><span class="chevron">→</span> <a href="/fire-pump-maintenance-sydney">Maintenance</a></li>
                            <li><span class="chevron">→</span> <a href="/fire-pump-testing-sydney">Testing</a></li>
                            <li><span class="chevron">→</span> <a href="/fire-pump-repairs-sydney">Fire Pump Repair</a></li>
                            <li><span class="chevron">→</span> <a href="/fire-pump-replacement-sydney">Replacement</a></li>
                            <li><span class="chevron">→</span> <a href="/fire-hydrant-repair-sydney">Fire Hydrant Repair</a></li>
                            <li><span class="chevron">→</span> <a href="/sprinkler-system-repair-sydney">Sprinkler System Repair</a></li>
                        </ul>
                    </div>
