    <title>Footer Component - Apex Pumps</title>
    <style>
        /* Reset and base styles with higher specificity */
        .apex-footer * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            border-radius: 0 !important;
        }

        .apex-footer {
            font-family: 'Source Sans Pro', sans-serif !important; 
            font-display: swap;
            line-height: 1.6;
            color: #1a1a1a;
            background-color: #f8f9fa;
            overflow-x: hidden;
        }

        .apex-footer .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Main Footer with higher specificity */
        .apex-footer .main-footer {
            background: linear-gradient(135deg, #1a4a5a 0%, #0d2a35 100%) !important;
            color: white !important;
            padding: 60px 0;
            position: relative;
            overflow: hidden;
        }

        .apex-footer .main-footer::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: #24ccff !important;
        }

        .apex-footer .main-footer .footer-content {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 40px;
        }

        .apex-footer .footer-column h5 {
            font-family: 'Roboto', sans-serif !important; 
            font-display: swap;
            font-weight: 700 !important;
            font-size: 1.3rem !important;
            margin-bottom: 20px !important;
            color: white !important;
        }

        .apex-footer .footer-column h4 {
            font-family: 'Roboto', sans-serif !important; 
            font-display: swap;
            font-weight: 700 !important;
            font-size: 1.3rem !important;
            margin-bottom: 20px !important;
            color: white !important;
        }

        .apex-footer .footer-column p {
            color: rgba(255,255,255,0.8) !important;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .apex-footer .footer-buttons {
            display: flex;
            gap: 15px;
            align-items: center;
        }

        .apex-footer .footer-btn {
            text-decoration: none !important;
            padding: 10px 20px;
            border-radius: 4px;
            font-family: 'Roboto', sans-serif !important; 
            font-display: swap;
            font-weight: 500 !important;
            font-size: 14px !important;
            transition: all 0.3s ease;
        }

        .apex-footer .footer-btn.primary {
            background: #000000 !important;
            color: white !important;
        }

        .apex-footer .footer-btn.primary:hover {
            background: #333333 !important;
            transform: translateY(-2px);
        }

        .apex-footer .footer-btn.linkedin {
            background: #24ccff !important;
            color: white !important;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 4px;
        }

        .apex-footer .footer-btn.linkedin span {
            font-weight: 700 !important;
            font-size: 16px !important;
        }

        .apex-footer .footer-btn.linkedin:hover {
            background: #1a9fd8 !important;
            transform: translateY(-2px);
        }

        .apex-footer .footer-services {
            list-style: none !important;
            padding: 0;
        }

        .apex-footer .footer-services li {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 12px;
            color: rgba(255,255,255,0.8) !important;
        }

        .apex-footer .footer-services .chevron {
            color: #24ccff !important;
            font-weight: bold !important;
            font-size: 14px !important;
        }

        .apex-footer .footer-services a {
            text-decoration: none !important;
            color: rgba(255,255,255,0.8) !important;
            transition: font-weight 0.3s ease;
        }

        .apex-footer .footer-services a:hover {
            font-weight: bold !important;
            color: rgba(255,255,255,1) !important;
        }

        .apex-footer .contact-column {
            background: #000000 !important;
            padding: 30px;
            border-radius: 0;
            margin-left: 20px;
        }

        .apex-footer .contact-column h5 {
            color: #ffffff !important;
        }

        .apex-footer .contact-column h4 {
            color: #ffffff !important;
        }

        .apex-footer .contact-column .contact-info {
            display: flex;
            flex-direction: column;
            gap: 15px;
            align-items: flex-start;
            text-align: left;
        }

        .apex-footer .contact-column .contact-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            color: #ffffff !important;
            font-weight: 800 !important;
            text-align: left !important;
            justify-content: flex-start !important;
            border-bottom: 1px solid white;
            padding-bottom: 10px;
            margin-bottom: 10px;
        }

        .apex-footer .contact-column .contact-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
            margin-bottom: 0;
        }

        .apex-footer .contact-column .contact-item,
        .apex-footer .contact-column .contact-item span,
        .apex-footer .contact-column .contact-item a,
        .apex-footer .contact-column .contact-item a:visited {
            color: #ffffff !important;
        }

        .apex-footer .contact-column .contact-icon {
            font-size: 16px !important;
            font-weight: bold !important;
            min-width: 20px;
            flex-shrink: 0;
        }

        .apex-footer .contact-column .contact-item a,
        .apex-footer .contact-column .contact-item span {
            text-align: left !important;
        }

        /* Footer with higher specificity */
        .apex-footer .footer {
            background: linear-gradient(135deg, #317b90 0%, #1a4a5a 50%, #317b90 100%) !important;
            color: white !important;
            padding: 60px 0 30px;
            position: relative;
            overflow: hidden;
        }

        .apex-footer .footer::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, #24ccff, #FFFFFF, #24ccff) !important;
        }

        .apex-footer .footer-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .apex-footer .footer-left {
            color: rgba(255,255,255,0.7) !important;
            font-size: 0.9rem !important;
        }

        .apex-footer .footer-right {
            color: rgba(255,255,255,0.7) !important;
            font-size: 0.9rem !important;
        }

        .apex-footer .footer-left a,
        .apex-footer .footer-right a {
            color: rgba(255,255,255,0.7) !important;
            text-decoration: none !important;
        }

        .apex-footer .footer-left a:hover,
        .apex-footer .footer-right a:hover {
            color: white !important;
        }

        /* Mobile Responsive */
        @media (max-width: 768px) {
            .apex-footer .main-footer .footer-content {
                grid-template-columns: 1fr;
                gap: 30px;
            }

            .apex-footer .contact-column {
                margin-left: 0;
                border-radius: 8px;
            }

            .apex-footer .footer-content {
                flex-direction: column;
                text-align: center;
            }
        }
    </style>
