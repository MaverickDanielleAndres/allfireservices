ull,"barcode":null,"requires_selling_plan":false,"selling_plan_allocations":[],"quantity_rule":{"min":1,"max":null,"increment":1}}],"images":["\/\/industro.com.au\/cdn\/shop\/files\/5kg-co2-fire-extinguisher.webp?v=1782307492","\/\/industro.com.au\/cdn\/shop\/files\/FB50CO2.jpg?v=1770915946"],"featured_image":"\/\/industro.com.au\/cdn\/shop\/files\/5kg-co2-fire-extinguisher.webp?v=1782307492","options":["Title"],"media":[{"alt":"5kg CO2 Fire Extinguisher","id":28419621584947,"position":1,"preview_image":{"aspect_ratio":1.0,"height":800,"width":800,"src":"\/\/industro.com.au\/cdn\/shop\/files\/5kg-co2-fire-extinguisher.webp?v=1782307492"},"aspect_ratio":1.0,"height":800,"media_type":"image","src":"\/\/industro.com.au\/cdn\/shop\/files\/5kg-co2-fire-extinguisher.webp?v=1782307492","width":800},{"alt":"5kg CO2 Fire Extinguisher Industro","id":27199502843955,"position":2,"preview_image":{"aspect_ratio":1.0,"height":1000,"width":1000,"src":"\/\/industro.com.au\/cdn\/shop\/files\/FB50CO2.jpg?v=1770915946"},"aspect_ratio":1.0,"height":1000,"media_type":"image","src":"\/\/industro.com.au\/cdn\/shop\/files\/FB50CO2.jpg?v=1770915946","width":1000}],"requires_selling_plan":false,"selling_plan_groups":[],"content":"\u003cul\u003e\n\t\u003cli\u003eFire Rating: 10B:E\u003c\/li\u003e\n\t\u003cli\u003eApprovals: AS\/NZS1841.6\u003c\/li\u003e\n\t\u003cli\u003eCertification: Global-Mark ID 109076\u003c\/li\u003e\n\t\u003cli\u003eActivfire Certified: Yes\u003c\/li\u003e\n\t\u003cli\u003eBox Quantity: 1\u003c\/li\u003e\n\t\u003cli\u003ePallet Quantity: 49\u003c\/li\u003e\n\t\u003cli\u003eBracket: Wall\u003c\/li\u003e\n\t\u003cli\u003eCylinder Construction: Aluminium\u003c\/li\u003e\n\t\u003cli\u003eCylinder Finish: Powder Coated\u003cbr\u003e\n\tRed\u003c\/li\u003e\n\t\u003cli\u003eProduct Dimensions: 665mmx152mm\u003c\/li\u003e\n\t\u003cli\u003eCarton Dimensions: 220x170x685mm\u003c\/li\u003e\n\t\u003cli\u003eGross Mass: 12.6kg\u003c\/li\u003e\n\t\u003cli\u003eHandle Finish: Stainless