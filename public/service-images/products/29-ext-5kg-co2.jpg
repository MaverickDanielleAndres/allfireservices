  <style> height-observer {display: unset;} x-header.header.color-scheme.color-scheme–scheme-2 {background: #fff !important;}  /* Prestige: make all product images square across site */ /* 1) Force the aspect ratio to 1:1 for all product tiles */.ProductItem .AspectRatio,.ProductRecommendations .ProductItem .AspectRatio,.Section--featured .ProductItem .AspectRatio,.CollectionMain .ProductItem .AspectRatio,.FeaturedProduct .AspectRatio {--aspect-ratio: 1 !important;}  /* Fallback for older Prestige builds that use padding on ::before */.AspectRatio::before {padding-bottom: 100% !important;}  /* 2) Make the image fill the square neatly */.AspectRatio > img,.ProductItem__Image,.ProductItem__ImageWrapper img {position: absolute !important; inset: 0 !important; width: 100% !important; height: 100% !important; object-fit: cover; /* use 'contain' if you prefer no crop */}  /* 3) Prevent overflow/cropping glitches on hover effects */.ProductItem__ImageWrapper,.AspectRatio {overflow: hidden;} </style>
