,"border":{"size":"1px","color":"#9e9e9e","enabled":true},"margin":{"mobile":{"top":"0px","left":"0px","right":"0px","bottom":"0px"},"desktop":{"top":"0px","left":"0px","right":"0px","bottom":"0px"}},"radius":{"value":"6px","enabled":true},"enabled":false,"padding":{"mobile":{"top":"4px","left":"12px","right":"12px","bottom":"4px"},"desktop":{"top":"8px","left":"16px","right":"16px","bottom":"8px"}},"textColor":"#000000","background":{"blur":"0px","color":"#eeeeee","enabled":true},"fontFamily":"font1","fontWeight":"600","textTransform":"uppercase","mobileFontSize":"12px","desktopFontSize":"14px"}],"border":{"size":"1px","color":"#000000","enabled":false},"layout":"column","margin":{"mobile":{"top":"0px","left":"0px","right":"0px","bottom":"0px"},"desktop":{"top":"0px","left":"0px","right":"0px","bottom":"0px"}},"radius":{"value":"8px","enabled":false},"padding":{"mobile":{"top":"4px","left":"0px","right":"0px","bottom":"4px"},"desktop":{"top":"8px","left":"28px","right":"28px","bottom":"8px"}},"mobileGap":"6px","background":{"src":null,"blur":"0px","source":"color","bgColor":"#ffffff","enabled":true,"overlayColor":"rgba(0,0,0,0)"},"desktopGap":"24px","mobileWidth":"100%","desktopWidth":"400px","backgroundClick":{"url":"","target":"_self","enabled":false}},"enabled":false,"general":{"font1":"inherit","font2":"inherit","font3":"inherit","preset":"bar1","breakpoint":"768px"},"section":null,"userCss":"","targeting":{"geo":null,"pages":{"cart":true,"home":true,"other":true,"password":true,"products":{"mode":"all","tags":[],"enabled":true,"specificProducts":[],"productsInCollections":[]},"collections":{"mode":"all","items":[],"enabled":true}}}}] || [];

      if (Array.isArray(window.GSC_COUNTDOWN_WIDGETS)) {
        // Embed and inline countdown blocks may load on the same page. Inline
        // pushes a single widget keyed by `key`; embed pushes the whole metafield
        // array. Dedup by `key` so the same widget isn't duplicated when both
        // blocks reference it. Widgets without a key push through (no dedup).
        widgets.forEach(function(w) {
          if (!w.key || !window.GSC_COUNTDOWN_WIDGETS.find(function(e) { return e.key === w.key; })) {
            window.GSC_COUNTDOWN_WIDGETS.push(w);
          }
        });
      } else {
        window.GSC_COUNTDOWN_WIDGETS = widgets;
      }

      // Stale-metafield guard via theme_store_id (TAE Liquid has `theme.id`
      // always null, so the check runs on JS). Mismatch = merchant switched
      // theme family after the last backend sync — fall back to runtime
      // defaults until re-sync writes a fresh metafield.
      
      
if (!window.GSC_COUNTDOWN_META) {
        window.GSC_COUNTDOWN_META = {
          product_collections: [{"id":295559266355,"handle":"fire-extinguishers","title":"Fire Extinguishers","updated_at":"2026-08-04T21:13:28+10:00","body_html":"\u003cp\u003e\u003cstrong\u003eFire extinguishers are a legal requirement in Australian workplaces\u003c\/strong\u003e, and matching the right type to the risks on site is what keeps people safe and keeps you compliant. The selection and placement of portable fire equipment is guided by AS 2444, and the extinguishers themselves are manufactured to AS\/NZS 1841. Industro supplies fire extinguishers to warehouses, workshops, construction sites, offices, factories, councils and trade businesses across Australia, in stock and ready to ship nationwide.\u003c\/p\u003e\u003ch2\u003eTypes of fire extinguisher, and what each is for\u003c\/h2\u003e\u003cp\u003eEvery extinguisher is rated for the fire classes it can safely tackle. Using the wrong type can make a fire worse, so it pays to match the extinguisher to the risk.\u003c\/p\u003e\u003cul\u003e\n\u003cli\u003e\n\u003cstrong\u003eABE dry chemical powder\u003c\/strong\u003e – the versatile all-rounder, rated for Class A (ordinary combustibles), B (flammable liquids) and E (electrical). The common choice for general and mixed-risk areas.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eCO2 (carbon dioxide)\u003c\/strong\u003e – for Class E electrical fires and Class B liquids. Leaves no residue, so it is ideal around switchboards, servers and electronics.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eFoam (AFFF)\u003c\/strong\u003e – for Class A and B fires, common in workshops and fuel-handling areas.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eWater\u003c\/strong\u003e – for Class A combustibles only, such as paper, timber and fabric. Never use on electrical or liquid fires.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eWet chemical\u003c\/strong\u003e – for Class F cooking oil and fat fires, the right choice for commercial kitchens.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003eNot sure which you need? Read \u003ca href=\"\/blogs\/news\/electrical-fire-classes-explained\"\u003eelectrical fire classes explained\u003c\/a\u003e and \u003ca href=\"\/blogs\/news\/what-fire-extinguisher-for-electrical-fires\"\u003ewhat fire extinguisher for electrical fires\u003c\/a\u003e.\u003c\/p\u003e\u003ch2\u003eRelated fire safety equipment\u003c\/h2\u003e\u003cul\u003e\n\u003cli\u003e\n\u003ca href=\"\/collections\/vehicle-fire-extinguishers\"\u003eVehicle fire extinguishers\u003c\/a\u003e for cars, trucks and plant\u003c\/li\u003e\n\u003cli\u003e\n\u003ca href=\"\/collections\/fire-blankets\"\u003eFire blankets\u003c\/a\u003e for kitchens and as a first response\u003c\/li\u003e\n\u003cli\u003e\n\u003ca href=\"\/collections\/fire-extinguisher-brackets\"\u003eFire extinguisher brackets and stands\u003c\/a\u003e for correct mounting\u003c\/li\u003e\n\u003cli\u003e\n\u003ca href=\"\/collections\/fire-extinguisher-signs\"\u003eFire extinguisher signs\u003c\/a\u003e for compliant placement\u003c\/li\u003e\n\u003c\/ul\u003e\u003ch2\u003eFire safety guides\u003c\/h2\u003e\u003cp\u003ePlain-English guides on what to use and how to protect specific environments:\u003c\/p\u003e\u003cul\u003e\n\u003cli\u003e\u003ca href=\"\/blogs\/news\/what-fire-extinguisher-for-electrical-fires\"\u003eWhat fire extinguisher for electrical fires?\u003c\/a\u003e\u003c\/li\u003e\n\u003cli\u003e\u003ca href=\"\/blogs\/news\/electrical-fire-classes-explained\"\u003eElectrical fire classes explained\u003c\/a\u003e\u003c\/li\u003e\n\u003cli\u003e\u003ca href=\"\/blogs\/news\/lithium-battery-fire-extinguishers\"\u003eLithium battery fire extinguishers\u003c\/a\u003e\u003c\/li\u003e\n\u003cli\u003e\u003ca href=\"\/blogs\/news\/switchboard-fire-extinguishers\"\u003eSwitchboard fire extinguishers\u003c\/a\u003e\u003c\/li\u003e\n\u003cli\u003e\u003ca href=\"\/blogs\/news\/server-room-fire-extinguishers\"\u003eServer room fire extinguishers\u003c\/a\u003e\u003c\/li\u003e\n\u003cli\u003e\u003ca href=\"\/blogs\/news\/data-centre-fire-extinguishers\"\u003eData centre fire extinguishers\u003c\/a\u003e\u003c\/li\u003e\n\u003cli\u003e\u003ca href=\"\/blogs\/news\/ev-charging-station-fire-extinguishers\"\u003eEV charging station fire extinguishers\u003c\/a\u003e\u003c\/li\u003e\n\u003cli\u003e\u003ca href=\"\/blogs\/news\/solar-battery-fire-extinguishers\"\u003eSolar battery fire extinguishers\u003c\/a\u003e\u003c\/li\u003e\n\u003cli\u003e\u003ca href=\"\/blogs\/news\/electrical-fire-safety-in-the-workplace\"\u003eElectrical fire safety in the workplace\u003c\/a\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\u003ch2\u003eWhy buy fire extinguishers from Industro\u003c\/h2\u003e\u003cul\u003e\n\u003cli\u003eAustralian supplier with the full range, in stock and ready to ship nationwide.\u003c\/li\u003e\n\u003cli\u003eExtinguishers manufactured to AS\/NZS 1841.\u003c\/li\u003e\n\u003cli\u003eBulk pricing and trade accounts available.\u003c\/li\u003e\n\u003cli\u003eReal help matching the right extinguisher to your site’s risks.\u003c\/li\u003e\n\u003c\/ul\u003e\u003ch2\u003eCommon questions\u003c\/h2\u003e\u003ch3\u003eWhat fire extinguisher is used for electrical fires?\u003c\/h3\u003e\u003cp\u003eIn Australia, electrical fires are Class E. CO2 extinguishers are preferred around sensitive equipment because they leave no residue, and ABE dry chemical is the versatile all-rounder. See \u003ca href=\"\/blogs\/news\/what-fire-extinguisher-for-electrical-fires\"\u003eour guide\u003c\/a\u003e.\u003c\/p\u003e\u003ch3\u003eWhat is AS 2444?\u003c\/h3\u003e\u003cp\u003eAS 2444 is the Australian Standard for the selection and location of portable fire extinguishers and fire blankets. It helps determine which extinguishers a workplace needs and where they should be placed.\u003c\/p\u003e\u003ch3\u003eHow often do fire extinguishers need servicing?\u003c\/h3\u003e\u003cp\u003ePortable fire extinguishers should be inspected and maintained at regular intervals in line with AS 1851, generally every six months. Always follow your servicing obligations.\u003c\/p\u003e\u003ch3\u003eHow fast can I get fire extinguishers delivered?\u003c\/h3\u003e\u003cp\u003eWe hold stock and dispatch quickly, shipping Australia-wide. For bulk or urgent orders, get in touch and we will sort it.\u003c\/p\u003e","published_at":"2025-12-02T05:59:42+11:00","sort_order":"best-selling","template_suffix":null,"disjunctive":false,"rules":[{"column":"tag","relation":"equals","condition":"Fire Extinguishers"}],"published_scope":"global"},{"id":295571882035,"handle":"fire-safety","title":"Fire Safety","updated_at":"2026-08-04T21:13:28+10:00","body_html":"","published_at":"2025-12-02T14:05:17+11:00","sort_order":"manual","template_suffix":"","disjunctive":true,"rules":[{"column":"tag","relation":"equals","condition":"Fire Extinguishers"},{"column":"tag","relation":"equals","condition":"Fire Blankets"},{"column":"tag","relation":"equals","condition":"Fire Extinguisher Brackets"},{"column":"tag","relation":"equals","condition":"Fire Extinguisher Signs"},{"column":"tag","relation":"equals","condition":"Fire Safety Signs"},{"column":"tag","relation":"equals","condition":"Vehicle Fire Extinguishers"}],"published_scope":"global"},{"id":295559430195,"handle":"vehicle-fire-extinguishers","title":"Vehicle Fire Extinguishers","updated_at":"2026-08-04T21:13:28+10:00","body_html":"","published_at":"2025-12-02T05:59:43+11:00","sort_order":"best-selling","template_suffix":null,"disjunctive":false,"rules":[{"column":"tag","relation":"equals","condition":"Vehicle Fire Extinguishers"}],"published_scope":"global"},{"id":295560642611,"handle":"vehicle-safety","title":"Vehicle Safety","updated_at":"2026-08-04T21:13:28+10:00","body_html":"","published_at":"2025-12-02T05:59:53+11:00","sort_order":"best-selling","template_suffix":"","disjunctive":true,"rules":[{"column":"tag","relation":"equals","condition":"Vehicle Safety"},{"column":"tag","relation":"equals","condition":"Mine Site Vehicle Products"},{"column":"tag","relation":"equals","condition":"Wheel Nut Indicators"},{"column":"tag","relation":"equals","condition":"UHF Call Signs"},{"column":"tag","relation":"equals","condition":"Mine Vehicle Flags"},{"column":"tag","relation":"equals","condition":"Safety Lights \u0026 Beacons"},{"column":"tag","relation":"equals","condition":"Vehicle First Aid Kits"},{"column":"tag","relation":"equals","condition":"Reflective Tapes"},{"column":"tag","relation":"equals","condition":"Vehicle Fire Extinguishers"},{"column":"tag","relation":"equals","condition":"Plant Asset Numbers"},{"column":"tag","relation":"equals","condition":"Ionnic Mine Bars"}],"published_scope":"global"}],
